<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <add value="index.php" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <rule name="index" enabled="false">
                    <match url="^(.*)/(agenda/public*)" />
                    <action type="Rewrite" url="{R:1}/{R:2}/index.php" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
